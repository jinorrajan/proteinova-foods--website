<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <radialGradient id="tableLight" cx="50%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#fff9f0"/>
      <stop offset="100%" stop-color="#e8d5be"/>
    </radialGradient>
    <linearGradient id="basketWood" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#a66e38"/>
      <stop offset="100%" stop-color="#5c3818"/>
    </linearGradient>
    <radialGradient id="eggGrad1" cx="40%" cy="35%" r="60%">
      <stop offset="0%" stop-color="#c4885c"/>
      <stop offset="100%" stop-color="#7d4a25"/>
    </radialGradient>
    <radialGradient id="yolkGrad" cx="35%" cy="35%" r="60%">
      <stop offset="0%" stop-color="#ffe66d"/>
      <stop offset="60%" stop-color="#fb8500"/>
      <stop offset="100%" stop-color="#d95d00"/>
    </radialGradient>
    <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="15" flood-color="#2d1a08" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Background Kitchen / Farm Table -->
  <rect width="800" height="600" fill="url(#tableLight)"/>
  
  <!-- Subtle Wooden Planks Pattern -->
  <line x1="0" y1="200" x2="800" y2="200" stroke="#d4be9f" stroke-width="1.5" opacity="0.4"/>
  <line x1="0" y1="400" x2="800" y2="400" stroke="#d4be9f" stroke-width="1.5" opacity="0.4"/>

  <!-- Farm Straw Nest Floor -->
  <g opacity="0.7">
    <path d="M180,380 Q320,410 520,380" stroke="#d9a85e" stroke-width="4" fill="none"/>
    <path d="M160,390 Q340,430 550,390" stroke="#e0b870" stroke-width="3" fill="none"/>
    <path d="M220,360 Q380,400 580,370" stroke="#c99544" stroke-width="3.5" fill="none"/>
  </g>

  <!-- Wicker Basket Body -->
  <ellipse cx="370" cy="310" rx="230" ry="140" fill="url(#basketWood)" filter="url(#softShadow)"/>
  <ellipse cx="370" cy="285" rx="215" ry="110" fill="#42240b"/>
  <ellipse cx="370" cy="280" rx="205" ry="100" fill="#e8c78c" opacity="0.85"/>

  <!-- Straw inside basket -->
  <path d="M200,260 Q300,230 400,270" stroke="#d49b49" stroke-width="5" fill="none"/>
  <path d="M240,240 Q350,290 480,250" stroke="#e8bc68" stroke-width="4" fill="none"/>
  <path d="M190,280 Q340,240 500,290" stroke="#c78d38" stroke-width="4.5" fill="none"/>

  <!-- Cluster of Eggs nestled inside basket -->
  <!-- Egg Back Left -->
  <ellipse cx="280" cy="230" rx="55" ry="72" fill="url(#eggGrad1)" transform="rotate(-20 280 230)" filter="url(#softShadow)"/>
  <!-- Egg Back Center -->
  <ellipse cx="360" cy="200" rx="58" ry="75" fill="url(#eggGrad1)" transform="rotate(5 360 200)" filter="url(#softShadow)"/>
  <!-- Egg Back Right -->
  <ellipse cx="445" cy="225" rx="55" ry="72" fill="url(#eggGrad1)" transform="rotate(25 445 225)" filter="url(#softShadow)"/>
  <!-- Egg Front Left -->
  <ellipse cx="305" cy="280" rx="60" ry="78" fill="url(#eggGrad1)" transform="rotate(-10 305 280)" filter="url(#softShadow)"/>
  <!-- Egg Front Center -->
  <ellipse cx="375" cy="265" rx="62" ry="80" fill="url(#eggGrad1)" transform="rotate(2 375 265)" filter="url(#softShadow)"/>
  <!-- Egg Front Right -->
  <ellipse cx="440" cy="285" rx="58" ry="76" fill="url(#eggGrad1)" transform="rotate(18 440 285)" filter="url(#softShadow)"/>

  
      <circle cx="280" cy="180" r="3" fill="#4a2c11" opacity="0.6"/>
      <circle cx="295" cy="195" r="2" fill="#4a2c11" opacity="0.7"/>
      <circle cx="310" cy="175" r="3.5" fill="#4a2c11" opacity="0.6"/>
      <circle cx="330" cy="190" r="2" fill="#4a2c11" opacity="0.5"/>
      <circle cx="370" cy="160" r="4" fill="#4a2c11" opacity="0.7"/>
      <circle cx="390" cy="175" r="2.5" fill="#4a2c11" opacity="0.6"/>
      <circle cx="430" cy="180" r="3" fill="#4a2c11" opacity="0.5"/>
    

  <!-- Green Farm Leaf in Basket -->
  <path d="M180,240 Q150,200 130,220 Q160,250 180,240 Z" fill="#407a3c"/>
  <path d="M180,240 Q210,190 230,210 Q200,250 180,240 Z" fill="#52944d"/>

  <!-- Foreground: Cracked Open Egg Showing Plump Golden Yolk -->
  <!-- Albumen puddle -->
  <path d="M520,440 Q620,420 680,460 Q720,510 650,540 Q570,550 510,510 Q470,470 520,440 Z" fill="#ffffff" opacity="0.6" filter="url(#softShadow)"/>
  
  <!-- Broken Shell Half -->
  <path d="M520,460 Q480,480 490,520 Q540,540 570,500 Q550,470 520,460 Z" fill="url(#eggGrad1)"/>
  <path d="M520,460 Q495,490 510,515 Q535,505 530,485 Z" fill="#fff5eb" opacity="0.85"/>

  <!-- Plump Domed Yolk in center -->
  <circle cx="615" cy="485" r="48" fill="url(#yolkGrad)" filter="url(#softShadow)"/>
  <!-- Yolk Specular Highlight -->
  <ellipse cx="600" cy="465" rx="14" ry="9" fill="#ffffff" opacity="0.75" transform="rotate(-30 600 465)"/>

  <!-- Second Shell Fragment -->
  <path d="M680,450 Q710,430 730,460 Q720,490 690,480 Z" fill="url(#eggGrad1)"/>

  <!-- Title Badge Banner -->
  <rect x="30" y="30" width="310" height="52" rx="26" fill="#073b2a" opacity="0.95"/>
  <circle cx="56" cy="56" r="16" fill="#fdc826"/>
  <text x="56" y="62" font-family="system-ui, sans-serif" font-size="16" font-weight="bold" fill="#073b2a" text-anchor="middle">✓</text>
  <text x="86" y="62" font-family="system-ui, sans-serif" font-size="16" font-weight="bold" fill="#ffffff">Country Free-Range Heritage</text>
</svg>